# Secrets and credentials must never be committed. The policy test and gitleaks
# are the enforcement; this file only keeps accidents out of `git status`.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
kubeconfig
talosconfig
.env
.env.*
*.pem
*.key
*.age
*.iso

# The nightly window's log and state, should pbs-night.ps1 ever run from the
# checkout instead of its install folder: the log can name a Wi-Fi network.
scripts/node2/pbs-night.log
scripts/node2/pbs-night.json

# Tool caches and editor noise
.venv/
__pycache__/
node_modules/
.DS_Store
Thumbs.db
*.swp
infrastructure/ansible/collections/
