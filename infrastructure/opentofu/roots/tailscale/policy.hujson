// Access policy of the tailnet. Source of truth: this file, applied with
// `just tofu tailscale apply`. Design: docs/adr/0005-administrative-access.md.
//
// Phase R, step R.3: the laptop may reach the hypervisor's SSH and web
// interface, and only through the administration container. Step R.8 gives
// the container its tag and approves its one route.
//
// Rules for this file:
//   - Grants only. No "acls" and no "ssh" section: Tailscale SSH is not used.
//   - A source is always one device, named by its tailnet address. Never a
//     group of people and never "*".
//   - Every grant names the one container it passes through.
//   - No grant names a phone or a container as its destination.
//   - Every device has a test: what it reaches, and what it must not. A test
//     by address also catches a grant made to the owner's login; a test by
//     login does not catch a grant made to an address (measured 2026-10-11),
//     so the tests here go by address.
{
	// An address is assigned when a device is enrolled and changes only when
	// it is enrolled anew.
	"hosts": {
		// The workstation (Node 2), enrolled 2026-10-10.
		"laptop": "100.85.8.57",
		// The owner's phone, enrolled 2026-10-10. Named for the tests only:
		// no grant mentions it before the household plan.
		"phone": "100.88.195.22",
		// The administration container, enrolled 2026-10-12 (step R.8). Named
		// for the tests only: it is a destination of no grant. The laptop
		// reaches the hypervisor *through* it (the `via` above), which does not
		// grant access to the container's own services.
		"remote1": "100.124.202.58",
	},

	// A device takes a tag at its login, and only a login listed here may
	// give it. The owner logs the container in at a browser (step R.8), so
	// the owner's own login is the one owner of the tag; no device can take
	// it by itself. (An empty list would mean the administrators, which is
	// the same person today and every administrator later.)
	"tagOwners": {
		// The administration container remote1.
		"tag:remote-admin": ["${owner_login}"],
	},

	// A route the tagged container advertises is approved without a click,
	// and only this one. Approval is decided when a route is first
	// advertised, so this is in place before the container logs in.
	"autoApprovers": {
		"routes": {
			"10.0.10.10/32": ["tag:remote-admin"],
		},
	},

	"grants": [
		{
			// E15 seen from the tailnet: the laptop to the hypervisor's SSH
			// and web interface, through the container and nothing else.
			"src": ["laptop"],
			"dst": ["10.0.10.10/32"],
			"ip":  ["tcp:22", "tcp:8006"],
			"via": ["tag:remote-admin"],
		},
	],

	// Checked by Tailscale every time the file changes, and by the wrapper
	// before every plan (scripts/tofu/child.sh). A failing test rejects the
	// file, so a mistake that opens something cannot be applied.
	"tests": [
		{
			"src": "laptop",
			"accept": [
				"10.0.10.10:22",
				"10.0.10.10:8006",
			],
			"deny": [
				// nothing else on the hypervisor
				"10.0.10.10:80",
				"10.0.10.10:3128",
				// not the router, not the access points
				"192.168.1.53:22",
				"10.0.10.2:22",
				"10.0.10.3:22",
				// not the container itself, by either address: the grant above
				// routes *through* it (via), which is not access to it
				"10.0.30.10:22",
				"remote1:22",
				"10.0.50.201:443",
				// not the phone
				"100.88.195.22:22",
				"100.88.195.22:80",
			],
		},
		{
			// The container's tag as a source reaches nothing: not its own
			// target, not the laptop, not the phone. It carries traffic; it
			// starts none.
			"src": "tag:remote-admin",
			"deny": [
				"10.0.10.10:22",
				"10.0.10.10:8006",
				"100.85.8.57:22",
				"100.85.8.57:3389",
				"100.88.195.22:22",
			],
		},
		{
			"src": "phone",
			"deny": [
				// nothing at home
				"10.0.10.10:22",
				"10.0.10.10:8006",
				"192.168.1.53:22",
				"10.0.30.10:22",
				"remote1:22",
				// nothing on the laptop: SSH, file sharing, remote desktop,
				// the forwarded backup port
				"100.85.8.57:22",
				"100.85.8.57:445",
				"100.85.8.57:3389",
				"100.85.8.57:8007",
			],
		},
	],
}
