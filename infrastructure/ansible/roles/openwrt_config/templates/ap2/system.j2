{# Managed by Ansible. Source of truth: this template plus the private inventory.
   Derived from the live device on 2026-10-05 (uci export system). #}
config system
	option hostname 'openwrt-router-4a-2'
	option timezone 'GMT0'
	option zonename 'UTC'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option compat_version '1.1'
	option log_proto 'udp'
	option conloglevel '8'
	option cronloglevel '7'

config timeserver 'ntp'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

config led
	option name 'blue: off'
	option sysfs 'blue:status'
	option trigger 'none'
	option default '0'
