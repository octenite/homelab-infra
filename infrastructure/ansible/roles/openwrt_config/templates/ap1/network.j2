{# Managed by Ansible. Source of truth: this template plus the private inventory.
   Derived from the live device on 2026-10-05 (uci export network). #}
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '{{ openwrt_dhcp_duid }}'
	option ula_prefix '{{ openwrt_ula_prefix }}'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ip6assign '60'
	option multipath 'off'
	option gateway '192.168.1.53'
	option delegate '0'
	list ipaddr '192.168.1.2/24'
