{# Managed by Ansible. Source of truth: this template plus the private inventory.
   Policy: docs/ARCHITECTURE.md section 6. Default deny between all zones and
   towards the router. Every allow below carries the ID of its exception (E1 to E13)
   or the word Router for a service the router itself offers to a zone. #}
{% set workstation = '192.168.1.196' %}
{% set pve1 = '10.0.10.10' %}
{% set access_points = ['10.0.10.2', '10.0.10.3'] %}
{% set k8s_api = '10.0.50.10' %}
{% set k8s_nodes = ['10.0.50.11', '10.0.50.21'] %}
{% set k8s_workers = ['10.0.50.21', '10.0.50.22'] %}
{% set gw_household = '10.0.50.200' %}
{% set gw_admin = '10.0.50.201' %}
config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

{% for z in ['lan', 'mgmt', 'servers', 'iot', 'guest'] %}
config zone
	option name '{{ z }}'
	list network '{{ z }}'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

{% endfor %}
config zone
	option name 'wan'
	list network 'wan'
	list network 'jiowan'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option masq '1'
	option mtu_fix '1'

config forwarding 'trusted_to_wan'
	option src 'lan'
	option dest 'wan'

config forwarding 'guest_to_wan'
	option src 'guest'
	option dest 'wan'

config forwarding 'e8_iot_to_wan'
	option src 'iot'
	option dest 'wan'

config forwarding 'e9_trusted_to_iot'
	option src 'lan'
	option dest 'iot'

config rule
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option family 'ipv4'
	option target 'ACCEPT'

{% for z in ['lan', 'iot', 'guest'] %}
config rule
	option name 'Router-DHCP-{{ z }}'
	option src '{{ z }}'
	option proto 'udp'
	option dest_port '67-68'
	option family 'ipv4'
	option target 'ACCEPT'

{% endfor %}
{% for z in ['lan', 'mgmt', 'servers', 'iot', 'guest'] %}
config rule
	option name 'Router-DNS-{{ z }}'
	option src '{{ z }}'
	option proto 'tcp udp'
	option dest_port '53'
	option target 'ACCEPT'

{% endfor %}
{% for z in ['lan', 'mgmt', 'servers', 'iot'] %}
config rule
	option name 'Router-NTP-{{ z }}'
	option src '{{ z }}'
	option proto 'udp'
	option dest_port '123'
	option target 'ACCEPT'

{% endfor %}
{% for z in ['lan', 'mgmt', 'servers'] %}
config rule
	option name 'Router-Ping-{{ z }}'
	option src '{{ z }}'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

{% endfor %}
config rule
	option name 'E1-workstation-to-router-ssh'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option proto 'tcp'
	option dest_port '22'
	option target 'ACCEPT'

config rule
	option name 'E2-workstation-to-pve1'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option dest 'mgmt'
	option dest_ip '{{ pve1 }}'
	option proto 'tcp'
	option dest_port '22 8006'
	option target 'ACCEPT'

{# E14 (owner decision 2026-10-06): the hypervisor reaches the backup server
   through the workstation's port forward when the direct link is down. #}
config rule
	option name 'E14-pve1-to-backup-server'
	option src 'mgmt'
	option src_ip '{{ pve1 }}'
	option dest 'lan'
	option dest_ip '{{ workstation }}'
	option proto 'tcp'
	option dest_port '8007'
	option target 'ACCEPT'

config rule
	option name 'E2-workstation-to-access-points'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option dest 'mgmt'
{% for a in access_points %}
	list dest_ip '{{ a }}'
{% endfor %}
	option proto 'tcp'
	option dest_port '22'
	option target 'ACCEPT'

config rule
	option name 'E2-workstation-to-mgmt-ping'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option dest 'mgmt'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'E3-workstation-to-kubernetes-api'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option dest 'servers'
	option dest_ip '{{ k8s_api }}'
	option proto 'tcp'
	option dest_port '6443'
	option target 'ACCEPT'

config rule
	option name 'E3-workstation-to-talos-api'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option dest 'servers'
{% for a in k8s_nodes %}
	list dest_ip '{{ a }}'
{% endfor %}
	option proto 'tcp'
	option dest_port '50000'
	option target 'ACCEPT'

config rule
	option name 'E3-workstation-to-admin-listener'
	option src 'lan'
	option src_ip '{{ workstation }}'
	option dest 'servers'
	option dest_ip '{{ gw_admin }}'
	option proto 'tcp'
	option dest_port '443'
	option target 'ACCEPT'

config rule
	option name 'E4-trusted-to-household-listener'
	option src 'lan'
	option dest 'servers'
	option dest_ip '{{ gw_household }}'
	option proto 'tcp'
	option dest_port '80 443'
	option target 'ACCEPT'

config rule
	option name 'E5-servers-to-wan-https'
	option src 'servers'
	option dest 'wan'
	option proto 'tcp'
	option dest_port '443'
	option target 'ACCEPT'

config rule
	option name 'E5-servers-to-public-resolvers'
	option src 'servers'
	option dest 'wan'
	list dest_ip '1.1.1.1'
	list dest_ip '9.9.9.9'
	option proto 'tcp udp'
	option dest_port '53'
	option target 'ACCEPT'

config rule
	option name 'E6-workers-to-pve1-api'
	option src 'servers'
{% for a in k8s_workers %}
	list src_ip '{{ a }}'
{% endfor %}
	option dest 'mgmt'
	option dest_ip '{{ pve1 }}'
	option proto 'tcp'
	option dest_port '8006'
	option target 'ACCEPT'

config rule
	option name 'E7-workers-to-pve1-exporters'
	option src 'servers'
{% for a in k8s_workers %}
	list src_ip '{{ a }}'
{% endfor %}
	option dest 'mgmt'
	option dest_ip '{{ pve1 }}'
	option proto 'tcp'
	option dest_port '9100 9633'
	option target 'ACCEPT'

config rule
	option name 'E11-mgmt-hosts-to-wan-updates'
	option src 'mgmt'
	list src_ip '{{ pve1 }}'
{% for a in access_points %}
	list src_ip '{{ a }}'
{% endfor %}
	option dest 'wan'
	option proto 'tcp'
	option dest_port '80 443'
	option target 'ACCEPT'

config rule
	option name 'E12-pve1-to-household-listener'
	option src 'mgmt'
	option src_ip '{{ pve1 }}'
	option dest 'servers'
	option dest_ip '{{ gw_household }}'
	option proto 'tcp'
	option dest_port '443'
	option target 'ACCEPT'

config rule
	option name 'E13-talos-to-pve1-ntp'
	option src 'servers'
{% for a in k8s_nodes %}
	list src_ip '{{ a }}'
{% endfor %}
	option dest 'mgmt'
	option dest_ip '{{ pve1 }}'
	option proto 'udp'
	option dest_port '123'
	option target 'ACCEPT'

{# Forced DNS, kept from the previous configuration: a client that addresses
   another resolver is answered by the router. The servers network is exempt
   because cert-manager must reach the two public resolvers of E5. #}
{% for z in ['lan', 'iot', 'guest'] %}
config redirect
	option name 'Force-DNS-{{ z }}'
	option src '{{ z }}'
	option proto 'tcp udp'
	option src_dport '53'
	option family 'ipv4'
	option target 'DNAT'

config rule
	option name 'Block-DoT-{{ z }}'
	option src '{{ z }}'
	option dest 'wan'
	option proto 'tcp'
	option dest_port '853'
	option target 'REJECT'

{% endfor %}
