{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Asia/Kolkata)",
  ],
  minimumReleaseAge: "3 days",
  // The private companion repository is pinned by hand.
  "git-submodules": { enabled: false },
  mise: {
    managerFilePatterns: ["/(^|/)mise\\.ci\\.toml$/"],
  },
  // Versions pinned in Ansible variables, marked with a "# renovate:" comment
  // on the line above (exporters on the hypervisor).
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^infrastructure/ansible/playbooks/group_vars/.*\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n[a-z_]+_version: (?<currentValue>[0-9.]+)\\n",
      ],
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
  ],
  packageRules: [
    {
      description: "Tooling that cannot reach a host or the cluster may merge itself after green CI",
      matchManagers: ["github-actions", "mise", "pre-commit"],
      automerge: true,
    },
    {
      description: "Everything that deploys is a reviewed pull request, grouped into the monthly window",
      matchFileNames: ["kubernetes/**", "infrastructure/**"],
      automerge: false,
      schedule: ["on the first day of the month"],
    },
  ],
}
